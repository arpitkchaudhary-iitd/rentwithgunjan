# Copy this file to .env.local and fill in real values before running the app.

# --- Database (Neon PostgreSQL recommended) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3001

# --- Email (Resend) ---
RESEND_API_KEY=re_...
# Without a verified domain, from must be: rentwithgunjan <onboarding@resend.dev>
# After adding your domain in Resend: noreply@rentwithgunjan.com
EMAIL_FROM=rentwithgunjan <noreply@rentwithgunjan.com>

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Admin seed credentials (used only during prisma db seed) ---
ADMIN_EMAIL=admin@rentwithgunjan.com
ADMIN_PASSWORD=choose-a-strong-password
