generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  password      String?
  emailVerified Boolean          @default(false)
  role          String           @default("customer")

  // Contact info
  phone         String?
  dateOfBirth   String?

  // Marketing preferences
  marketingOptIn     Boolean @default(false)
  preferredContact   String? // "email" | "phone" | "sms"

  // Real estate cross-sell (optional, explicit consent via realEstateInterest flag)
  realEstateInterest    Boolean @default(false)
  preferredNeighborhood String? // e.g. "Hoboken", "Jersey City", "Newark"
  propertyTypeInterest  String? // "condo" | "house" | "apartment" | "commercial"
  householdStatus       String? // "renting" | "owns" | "looking-to-buy"

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  bookings      Booking[]
  documents     DocumentUpload[]
  tokens        Token[]
}

model Token {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Vehicle {
  id        String    @id @default(cuid())
  name      String
  type      String
  dailyRate Int
  deposit   Int
  imageUrl  String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

model Booking {
  id         String           @id @default(cuid())
  userId     String
  vehicleId  String
  pickupDate DateTime         @db.Date
  returnDate DateTime         @db.Date
  status     BookingStatus    @default(PENDING)
  subtotal   Int
  tax        Int
  deposit    Int              @default(0)
  total      Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user       User             @relation(fields: [userId], references: [id])
  vehicle    Vehicle          @relation(fields: [vehicleId], references: [id])
  payment    Payment?
  documents  DocumentUpload[]
}

model Payment {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  provider        String
  status          String
  amount          Int
  currency        String   @default("USD")
  stripeSessionId String?
  createdAt       DateTime @default(now())

  booking         Booking  @relation(fields: [bookingId], references: [id])
}

model DocumentUpload {
  id         String   @id @default(cuid())
  bookingId  String?
  userId     String
  fileName   String
  storageUrl String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  booking    Booking? @relation(fields: [bookingId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}
